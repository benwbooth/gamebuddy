+
+void wlserver_mousewheel2( int32_t nDiscreteX, int32_t nDiscreteY, double flX, double flY, uint32_t uTime, uint32_t uSource )
+{
+    assert( wlserver_is_lock_held() );
+    // Stationary scrolling is pointer activity: hiding the cursor would make
+    // pointer-only Steam overlays lose focus in the middle of the gesture.
+    wlserver_pointer_activity();
+    auto source = static_cast<wl_pointer_axis_source>( uSource );
+    wlr_seat_pointer_notify_axis( wlserver.wlr.seat, uTime, WL_POINTER_AXIS_HORIZONTAL_SCROLL, flX, nDiscreteX, source, WL_POINTER_AXIS_RELATIVE_DIRECTION_IDENTICAL );
