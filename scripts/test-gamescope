#!/usr/bin/env bash
# Run inside `nix develop`. This creates only an isolated test game/session.
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd -- "$project_dir"
cargo build -p gamebuddy-app -p gamebuddy-overlay --bin gamebuddy --examples
runtime_dir="$(mktemp -d /tmp/gamebuddy-overlay-test-XXXXXXXX)"
export GAMEBUDDY_TEST_DATA="$runtime_dir/data"
export GAMEBUDDY_TEST_LOG="$runtime_dir/runtime.log"
export XDG_CONFIG_HOME="$runtime_dir/config"
./target/debug/examples/compositor_probe --prepare "$GAMEBUDDY_TEST_DATA"
prepare_flags=(--no-prepare)
if [[ -n "${GAMEBUDDY_TEST_NAVIGATION:-}" ]]; then prepare_flags=(); fi
./target/debug/gamebuddy --launch --windowed "${prepare_flags[@]}" --quiet --no-listen --ui-trace --crop-trace --navigation-trace --data-dir "$GAMEBUDDY_TEST_DATA" -- \
    ./target/debug/examples/compositor_probe "$runtime_dir/proof" 2>&1 | tee "$GAMEBUDDY_TEST_LOG"
printf 'Overlay test artifacts: %s\n' "$runtime_dir/proof"
