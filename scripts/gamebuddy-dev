#!/usr/bin/env bash
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
binary="$project_dir/target/debug/gamebuddy"
# Lunchpail can itself run inside a different Nix development shell. Running
# Cargo here inherits its compiler flags, triggers rebuilds/build-lock waits,
# and can exceed the compositor handshake deadline. Build separately; a game
# launch only needs GameBuddy's runtime environment and existing executable.
if [[ ! -x "$binary" ]]; then
    printf 'GameBuddy has not been built. Run: nix develop %q --command cargo build --manifest-path %q --bin gamebuddy\n' \
        "$project_dir" "$project_dir/Cargo.toml" >&2
    exit 1
fi
# Load the flake environment through nix-direnv, which keeps it as a GC root
# under .direnv/. Without a root, routine garbage collection deletes the
# development environment and the next game launch stalls rebuilding it.
if command -v direnv >/dev/null 2>&1 && (cd "$project_dir" && direnv status --json 2>/dev/null) \
    | tr -d ' \n' | grep -q '"foundRC":{"allowed":0,'; then
    exec direnv exec "$project_dir" "$binary" "$@"
fi
# Without an allowed .envrc, keep an equivalent root as a Nix profile.
exec nix develop --profile "$project_dir/.nix-dev-profile" "$project_dir" --command "$binary" "$@"
