#!/usr/bin/env bash
# Uses the signed-in Codex subscription and dedicated virtual audio devices.
# Run inside nix develop. No physical microphone or speaker is used.
set -euo pipefail
cd "$(dirname "$0")/.."
cargo build -p gamebuddy-app -p gamebuddy-cli -p gamebuddy-overlay --bin gamebuddy --bin gamebuddy-cli --examples
runtime_dir="$(mktemp -d /tmp/gamebuddy-realtime-test-XXXXXXXX)"
export XDG_CONFIG_HOME="$runtime_dir/config"
printf 'Realtime voice fixture: %s\n' "$runtime_dir"
export GAMEBUDDY_TEST_DATA="$runtime_dir/data" GAMEBUDDY_TEST_REALTIME=1
export GAMEBUDDY_TEST_SCREEN=1
export GAMEBUDDY_TEST_MIC_SINK="gamebuddy_test_input_$$"
export GAMEBUDDY_TEST_MIC_SOURCE="gamebuddy_test_mic_$$"
export GAMEBUDDY_AUDIO_SOURCE="$GAMEBUDDY_TEST_MIC_SOURCE"
export PULSE_SOURCE="$GAMEBUDDY_TEST_MIC_SOURCE" PULSE_SINK="gamebuddy_test_output_$$"
export GAMEBUDDY_TEST_VOICE_WAV="$runtime_dir/request.wav"
export GAMEBUDDY_TEST_LOG="$runtime_dir/runtime.log"
modules=(); recorder=""; player=""
cleanup(){
  if [[ -n "$recorder" ]]; then kill -INT "$recorder" 2>/dev/null || true; wait "$recorder" 2>/dev/null || true; fi
  if [[ -n "$player" ]]; then kill "$player" 2>/dev/null || true; wait "$player" 2>/dev/null || true; fi
  for ((i=${#modules[@]}-1;i>=0;i--)); do pactl unload-module "${modules[i]}"; done
}
trap cleanup EXIT
modules+=("$(pactl load-module module-null-sink sink_name="$GAMEBUDDY_TEST_MIC_SINK" sink_properties=device.description=GameBuddyTestInput)")
modules+=("$(pactl load-module module-remap-source master="$GAMEBUDDY_TEST_MIC_SINK.monitor" source_name="$GAMEBUDDY_TEST_MIC_SOURCE" source_properties=device.description=GameBuddyTestMic)")
modules+=("$(pactl load-module module-null-sink sink_name="$PULSE_SINK" sink_properties=device.description=GameBuddyTestOutput)")
# Feed the assistant's output back into the private test microphone, like
# speaker echo. Production playback suppression must prevent a self-reply loop.
modules+=("$(pactl load-module module-loopback source="$PULSE_SINK.monitor" sink="$GAMEBUDDY_TEST_MIC_SINK" latency_msec=20)")
# Already unmuted before launch: the fixture must talk without any UI action
# or post-launch mute/unmute gesture. test-voice covers initially muted startup.
pactl set-source-mute "$GAMEBUDDY_TEST_MIC_SOURCE" 0
# Keep synthetic player speech outside the launched game's process tree so
# game-volume ducking cannot attenuate the test microphone during interruption.
export GAMEBUDDY_TEST_PLAY_SOCKET="$runtime_dir/player.sock"
node --input-type=module - "$GAMEBUDDY_TEST_PLAY_SOCKET" "$GAMEBUDDY_TEST_MIC_SINK" <<'JS' &
import net from 'node:net';
import {spawn} from 'node:child_process';
const [socket,sink]=process.argv.slice(2);
net.createServer(client=>{let text='';client.on('data',data=>{text+=data;if(!text.includes('\n'))return;client.removeAllListeners('data');const path=JSON.parse(text.trim());const child=spawn('paplay',['--device',sink,path]);child.on('error',e=>client.end(String(e)));child.on('exit',code=>client.end(code===0?'ok':`paplay exit ${code}`));});}).listen(socket);
JS
player=$!
for attempt in {1..100}; do [[ -S "$GAMEBUDDY_TEST_PLAY_SOCKET" ]] && break; sleep 0.05; done
nix run nixpkgs#espeak-ng -- -v en-us -s 145 -w "$GAMEBUDDY_TEST_VOICE_WAV" 'Please inspect the actual screenshot of my game. What shapes, colors and background can you see? Put your description in a text widget titled Voice Works. Then tell me what you see.'
if [[ -n "${GAMEBUDDY_TEST_WORKING:-}" ]]; then
  export QTWEBENGINE_REMOTE_DEBUGGING="127.0.0.1:$((20000+RANDOM))"
  export GAMEBUDDY_TEST_PRESENCE_WAV="$runtime_dir/presence.wav" GAMEBUDDY_TEST_COMMAND_WAV="$runtime_dir/command.wav"
  nix run nixpkgs#espeak-ng -- -v en-us -s 145 -w "$GAMEBUDDY_TEST_VOICE_WAV" 'Look at my game and create a text widget titled Waiting Test naming the visible colors. Then say exactly: The answer is ready.'
  nix run nixpkgs#espeak-ng -- -v en-us -s 120 -w "$GAMEBUDDY_TEST_PRESENCE_WAV" 'Hello.'
  nix run nixpkgs#espeak-ng -- -v en-us -s 145 -w "$GAMEBUDDY_TEST_COMMAND_WAV" 'Please open the guide.'
fi
if [[ -n "${GAMEBUDDY_TEST_SCENE:-}" ]]; then
  export GAMEBUDDY_TEST_GATE_WAV="$runtime_dir/gate.wav"
  nix run nixpkgs#espeak-ng -- -v en-us -s 145 -w "$GAMEBUDDY_TEST_GATE_WAV" 'Look at the game. I am stuck against the wall at the far right edge of town. What should I do here?'
fi
if [[ -n "${GAMEBUDDY_TEST_PROGRESS:-}" ]]; then
  export QTWEBENGINE_REMOTE_DEBUGGING="127.0.0.1:9345"
  export GAMEBUDDY_TEST_PROGRESS_WAV="$runtime_dir/progress.wav" GAMEBUDDY_TEST_COMPLETION_WAV="$runtime_dir/completion.wav" GAMEBUDDY_TEST_RECOVERY_WAV="$runtime_dir/recovery.wav"
  nix run nixpkgs#espeak-ng -- -v en-us -s 145 -w "$GAMEBUDDY_TEST_PROGRESS_WAV" 'Where do I go now?'
  nix run nixpkgs#espeak-ng -- -v en-us -s 145 -w "$GAMEBUDDY_TEST_COMPLETION_WAV" 'I already killed the enemy and opened the gate out of Eolis. I am way past that. What should I do here?'
  nix run nixpkgs#espeak-ng -- -v en-us -s 145 -w "$GAMEBUDDY_TEST_RECOVERY_WAV" 'Hello. Are you still there? Please say ready to help.'
fi
if [[ -n "${GAMEBUDDY_TEST_LOCATION:-}" ]]; then
  export GAMEBUDDY_TEST_LOCATION_WAV="$runtime_dir/location.wav"
  nix run nixpkgs#espeak-ng -- -v en-us -s 145 -w "$GAMEBUDDY_TEST_LOCATION_WAV" 'I already walked there. I am at the restoration vendors now. Stop telling me to walk left toward them. What should I do here?'
fi
if [[ -n "${GAMEBUDDY_TEST_CAPTIONS:-}" ]]; then
  export GAMEBUDDY_TEST_ONSET_WAV="$runtime_dir/onset.wav"
  nix run nixpkgs#espeak-ng -- -v en-us -s 145 -w "$GAMEBUDDY_TEST_ONSET_WAV" 'Please say this exact sentence once: Purple elephants dance in the sunshine, and blue rivers wind through quiet valleys beneath the morning sun.'
fi
if [[ -n "${GAMEBUDDY_TEST_RESPONSIVE:-}" ]]; then
  export GAMEBUDDY_TEST_STORY_WAV="$runtime_dir/story.wav" GAMEBUDDY_TEST_INTERRUPT_WAV="$runtime_dir/interrupt.wav" GAMEBUDDY_TEST_STOP_WAV="$runtime_dir/stop.wav"
  nix run nixpkgs#espeak-ng -- -v en-us -s 145 -w "$GAMEBUDDY_TEST_STORY_WAV" 'Tell me a five paragraph forest adventure at least two hundred and fifty words long ending with the exact words the silver lantern glows.'
  nix run nixpkgs#espeak-ng -- -v en-us -s 145 -w "$GAMEBUDDY_TEST_INTERRUPT_WAV" 'Stop the story. What color is the tall rectangle on my screen? Put the answer in a text widget titled Interruption Works, then tell me briefly.'
  nix run nixpkgs#espeak-ng -- -v en-us -s 145 -w "$GAMEBUDDY_TEST_STOP_WAV" 'Stop.'
fi
./target/debug/examples/compositor_probe --prepare "$GAMEBUDDY_TEST_DATA"
if [[ -n "${GAMEBUDDY_TEST_STORE:-}" ]]; then
  [[ "$GAMEBUDDY_TEST_STORE" == /tmp/* && -n "${GAMEBUDDY_TEST_SCENE:-}" ]]
  cp "$GAMEBUDDY_TEST_STORE/gamebuddy.sqlite" "$GAMEBUDDY_TEST_DATA/gamebuddy.sqlite"
  cp -a "$GAMEBUDDY_TEST_STORE/maps" "$GAMEBUDDY_TEST_DATA/maps"
  if [[ -n "${GAMEBUDDY_TEST_PROGRESS:-}" ]]; then
    # Retain the real progress and conversation, but hide copied OSD widgets
    # so the fixture can verify keyboard focus before drawing its scene.
    node --input-type=module - "$GAMEBUDDY_TEST_DATA/gamebuddy.sqlite" <<'JS'
import {DatabaseSync} from 'node:sqlite';
const db = new DatabaseSync(process.argv[2]);
db.exec("DELETE FROM documents WHERE key LIKE 'widgets:%' OR key LIKE 'widget-visibility:%' OR key='widget-layout'");
db.close();
JS
  fi
fi
cat >"$runtime_dir/settings.json" <<'JSON'
{"reasoning":{"kind":"codex","endpoint":"","model":"","api_key_env":""},"vision":{"kind":"ollama","endpoint":"http://127.0.0.1:11434","model":"qwen3.5:4b","api_key_env":""},"speech":"codex_realtime"}
JSON
./target/debug/gamebuddy-cli --data-dir "$GAMEBUDDY_TEST_DATA" configure "$runtime_dir/settings.json"
if [[ -n "${GAMEBUDDY_TEST_VOICE_MODEL:-}" ]]; then
  node -e 'const fs=require("fs"),p=process.argv[1],s=JSON.parse(fs.readFileSync(p));s.reasoning.model=process.env.GAMEBUDDY_TEST_VOICE_MODEL;fs.writeFileSync(p,JSON.stringify(s))' "$runtime_dir/settings.json"
  ./target/debug/gamebuddy-cli --data-dir "$GAMEBUDDY_TEST_DATA" configure "$runtime_dir/settings.json"
fi
date +%s%3N > "$runtime_dir/recording-start-ms"
parec --device="$PULSE_SINK.monitor" --file-format=wav "$runtime_dir/response.wav" & recorder=$!
./target/debug/gamebuddy --launch --windowed --no-prepare --ui-trace --voice-trace --data-dir "$GAMEBUDDY_TEST_DATA" -- \
    ./target/debug/examples/compositor_probe "$runtime_dir/proof" >"$GAMEBUDDY_TEST_LOG" 2>&1
kill -INT "$recorder"; wait "$recorder" || true; recorder=""
ffmpeg -hide_banner -i "$runtime_dir/response.wav" -af volumedetect -f null - >"$runtime_dir/audio-check.txt" 2>&1
# The microphone transcriber caps each input at 45 seconds. Transcribe the
# complete recording in shorter chunks so a slow tool reply is still checked.
ffmpeg -nostdin -hide_banner -loglevel error -y -i "$runtime_dir/response.wav" -f segment -segment_time 40 "$runtime_dir/heard-%03d.wav"
: >"$runtime_dir/heard.txt"
for chunk in "$runtime_dir"/heard-*.wav; do
  ./target/debug/gamebuddy-cli --data-dir "$GAMEBUDDY_TEST_DATA" transcribe "$chunk" >>"$runtime_dir/heard.txt"
done
if [[ -n "${GAMEBUDDY_TEST_WORKING:-}" ]]; then
  if rg -qi "still working|i.m on it" "$runtime_dir/heard.txt"; then
    printf 'Unexpected spoken filler in the recording\n' >&2
    exit 1
  fi
  if ! rg -qi 'answer is ready' "$runtime_dir/heard.txt"; then
    rg -qi '\bred\b' "$runtime_dir/heard.txt"
    rg -qi '\bgreen\b' "$runtime_dir/heard.txt"
  fi
  node scripts/test-work-progress-audio.mjs "$runtime_dir"
elif [[ -n "${GAMEBUDDY_TEST_PROGRESS:-}" ]]; then
  rg -qi 'ready to help' "$runtime_dir/heard.txt"
elif [[ -n "${GAMEBUDDY_TEST_SCENE:-}" ]]; then
  rg -qi '\bkey\b' "$runtime_dir/heard.txt"
else
  rg -qi '\bred\b' "$runtime_dir/heard.txt"
  rg -qi '\bgreen\b' "$runtime_dir/heard.txt"
fi
if [[ -n "${GAMEBUDDY_TEST_CAPTIONS:-}" ]]; then
  rg -qi 'purple elephants?' "$runtime_dir/heard.txt"
fi
if [[ -n "${GAMEBUDDY_TEST_RESPONSIVE:-}" ]]; then
  rg -qi 'silver lantern glows' "$runtime_dir/heard.txt"
fi
# Keep a separate tail excerpt for the later selected visual feedback.
ffmpeg -nostdin -hide_banner -loglevel error -y -sseof -30 -i "$runtime_dir/response.wav" "$runtime_dir/feedback.wav"
./target/debug/gamebuddy-cli --data-dir "$GAMEBUDDY_TEST_DATA" transcribe "$runtime_dir/feedback.wav" >"$runtime_dir/feedback-heard.txt"
printf 'Realtime voice evidence: %s\n' "$runtime_dir"
cat "$runtime_dir/heard.txt"
cat "$runtime_dir/feedback-heard.txt"
